# Copy this file to backend/.env.local and fill in the values.
# Supabase dashboard → Project Settings → API.

# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Service role key: SERVER ONLY. It bypasses Row Level Security, so never put it in the frontend
# or commit it. (.env.local is ignored by git.)
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Frontend origin allowed to call this API when deployed on a different domain.
ALLOWED_ORIGIN="http://localhost:3000"
